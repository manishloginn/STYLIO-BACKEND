NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/stylio?replicaSet=rs0
JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
OTP_PROVIDER=dev
PAYMENT_PROVIDER=dev
DEV_OTP_CODE=482913
DEV_WEBHOOK_SECRET=replace-with-a-long-random-string
OTP_PEPPER=replace-with-a-long-random-string
WEB_ORIGIN=http://127.0.0.1:5173
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# Callback:  POST {api}/api/v1/payments/razorpay/callback
# Webhook:   POST {api}/api/v1/payments/razorpay/webhook
# In the Razorpay dashboard, set the webhook secret to RAZORPAY_WEBHOOK_SECRET
# and subscribe to payment.captured, payment.failed, and order.paid.
# SEED=true
